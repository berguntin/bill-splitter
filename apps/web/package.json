{
  "name": "@bill-splitter/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "start": "serve dist --no-clipboard --listen tcp://0.0.0.0:${PORT:-4173}"
  },
  "dependencies": {
    "@bill-splitter/core": "workspace:*",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@sentry/vue": "^11.6.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "serve": "^14.2.6",
    "vue": "^3.5.43",
    "vue-i18n": "11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sentry/vite-plugin": "^5.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
