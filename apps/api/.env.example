PORT=3000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Claude API key used to read receipts. Without it, a fake parser returns a
# sample receipt (development only).
ANTHROPIC_API_KEY=
# Number of reverse proxies in front of the API (e.g. 1 on most hosts).
TRUST_PROXY=0
# Receipt scans allowed per client IP every 10 minutes.
RECEIPT_RATE_LIMIT=20
# MongoDB for shared bills (required in production). Without it, shared bills
# live in memory and are lost when the API restarts.
MONGODB_URI=
# Database used inside that cluster.
MONGODB_DATABASE=bill-splitter
# Days a shared bill is kept after its last update.
BILL_TTL_DAYS=7
# Minimum log level: fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=
# Sentry project DSN (Node). Without it, errors are only logged.
SENTRY_DSN=
# Environment name shown in Sentry; defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Bug reports are stored in MongoDB for this many days.
REPORT_TTL_DAYS=90
# Fine-grained GitHub token with "Issues: read and write" on the repository
# below. With it, each bug report opens (or comments on) a GitHub issue.
GITHUB_TOKEN=
GITHUB_REPOSITORY=berguntin/bill-splitter
