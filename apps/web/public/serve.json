{
  "rewrites": [
    { "source": "/scan", "destination": "/index.html" },
    { "source": "/bill/**", "destination": "/index.html" },
    { "source": "/b/**", "destination": "/index.html" },
    { "source": "/report", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "assets/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "**/*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
